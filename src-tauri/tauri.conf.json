{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MDCoder",
  "version": "0.1.0",
  "identifier": "app.mdcoder.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://127.0.0.1:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "MDCoder",
        "width": 1280,
        "height": 820,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "transparent": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: asset: https:; font-src 'self' data:; connect-src 'self' ipc: https://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg", "nsis", "msi", "deb", "appimage", "rpm"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Productivity",
    "shortDescription": "Local-first markdown editor.",
    "longDescription": "MDCoder is a fast, local-first markdown editor with live preview, plugins, and export to PDF / HTML / DOCX / Markdown.",
    "copyright": "© 2026 MDCoder Authors",
    "publisher": "MDCoder",
    "homepage": "https://mdcoder.app",
    "licenseFile": "../LICENSE",
    "fileAssociations": [
      {
        "ext": ["md", "markdown", "mdx"],
        "name": "Markdown Document",
        "description": "Markdown document",
        "role": "Editor"
      }
    ],
    "macOS": {
      "minimumSystemVersion": "11.0",
      "dmg": {
        "background": null,
        "windowSize": { "width": 660, "height": 420 },
        "appPosition": { "x": 180, "y": 200 },
        "applicationFolderPosition": { "x": 480, "y": 200 }
      },
      "entitlements": null
    },
    "windows": {
      "digestAlgorithm": "sha256",
      "timestampUrl": "http://timestamp.digicert.com",
      "webviewInstallMode": { "type": "downloadBootstrapper", "silent": true }
    },
    "linux": {
      "appimage": { "bundleMediaFramework": false },
      "deb": {
        "depends": ["libwebkit2gtk-4.1-0", "libgtk-3-0"]
      }
    }
  },
  "plugins": {}
}
